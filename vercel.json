{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["views/**", "routes/**", "db/**", "middleware/**", "utils/**"]
      }
    },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    {
      "src": "/images/(.*)",
      "headers": { "Cache-Control": "public, max-age=86400, s-maxage=31536000" },
      "dest": "/public/images/$1"
    },
    {
      "src": "/favicon\\.svg",
      "headers": { "Cache-Control": "public, max-age=86400, s-maxage=31536000" },
      "dest": "/public/favicon.svg"
    },
    { "src": "/(.*)", "dest": "/api/index.js" }
  ]
}
