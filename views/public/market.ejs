<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<%- include('../partials/seo-head') %>
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
  :root { --ink:#1a1a18; --paper:#fefdfb; --cream:#f6f1e8; --cream-2:#eee6d9; --gold:#d4920b; --gold-dark:#a76d03; --muted:#706c64; --line:#e3dccf; --white:#fff; }
  * { box-sizing:border-box; }
  html { scroll-behavior:smooth; }
  body { margin:0; color:var(--ink); background:var(--paper); font-family:'DM Sans',sans-serif; font-weight:300; }
  a { color:inherit; }
  img { max-width:100%; }
  .container { width:min(1200px,calc(100% - 48px)); margin:0 auto; }
  .nav { position:relative; z-index:10; border-bottom:1px solid rgba(255,255,255,.18); background:var(--ink); color:#fff; }
  .nav-inner { min-height:84px; display:flex; align-items:center; justify-content:space-between; gap:30px; }
  .brand { display:flex; align-items:center; gap:10px; color:#fff; text-decoration:none; }
  .brand svg { width:22px; height:28px; }
  .brand-name { display:block; font:600 29px/1 'Cormorant Garamond',serif; }
  .brand-tag { display:block; margin-top:3px; font-size:8px; letter-spacing:.13em; text-transform:uppercase; color:#c8c3ba; }
  .nav-links { display:flex; align-items:center; gap:28px; font-size:13px; }
  .nav-links a { text-decoration:none; color:#e7e2da; }
  .nav-links a:hover { color:#fff; }
  .nav-cta { padding:10px 16px; border:1px solid rgba(255,255,255,.45); }
  .nav-apply { color:var(--ink)!important; background:var(--gold); border-color:var(--gold); font-weight:500; }
  .hero { background:var(--ink); color:#fff; padding:82px 0 94px; overflow:hidden; position:relative; }
  .hero::after { content:''; position:absolute; width:520px; height:520px; border:1px solid rgba(212,146,11,.2); border-radius:50%; right:-170px; top:-190px; box-shadow:0 0 0 70px rgba(212,146,11,.035),0 0 0 140px rgba(212,146,11,.02); }
  .hero-inner { position:relative; z-index:1; max-width:870px; }
  .eyebrow { color:#e2ae43; text-transform:uppercase; letter-spacing:.2em; font-size:11px; font-weight:600; }
  h1 { font:500 clamp(48px,7vw,78px)/.98 'Cormorant Garamond',serif; letter-spacing:-.025em; margin:18px 0 24px; max-width:850px; }
  .hero-lede { color:#d4d0c9; font-size:clamp(17px,2vw,20px); line-height:1.75; max-width:780px; margin:0; }
  .hero-points { display:flex; flex-wrap:wrap; gap:12px 26px; margin-top:34px; font-size:13px; color:#f3eee5; }
  .hero-points span { display:flex; align-items:center; gap:8px; }
  .hero-points span::before { content:'✓'; color:var(--gold); font-weight:600; }
  .search-wrap { position:relative; z-index:3; margin-top:-38px; }
  .search-bar { display:grid; grid-template-columns:1fr 1fr 1.15fr auto; gap:0; background:#fff; border:1px solid var(--line); box-shadow:0 18px 55px rgba(35,29,19,.12); }
  .field { padding:19px 22px; border-right:1px solid var(--line); }
  .field label { display:block; margin-bottom:7px; color:var(--muted); font-size:10px; font-weight:600; letter-spacing:.12em; text-transform:uppercase; }
  .field select,.field input { width:100%; border:0; outline:0; background:transparent; color:var(--ink); font:400 14px 'DM Sans',sans-serif; }
  .date-inputs { display:grid; grid-template-columns:1fr 1fr; gap:10px; }
  .search-button { border:0; background:var(--gold); color:var(--ink); padding:0 32px; font:600 13px 'DM Sans',sans-serif; cursor:pointer; }
  .search-button:hover { background:#e0a129; }
  .section { padding:92px 0; }
  .section-soft { background:var(--cream); }
  .section-head { display:flex; justify-content:space-between; gap:30px; align-items:end; margin-bottom:38px; }
  .section-label { color:var(--gold-dark); text-transform:uppercase; letter-spacing:.17em; font-size:10px; font-weight:600; margin-bottom:10px; }
  h2 { font:500 clamp(36px,5vw,54px)/1.05 'Cormorant Garamond',serif; letter-spacing:-.02em; margin:0; }
  .section-intro { max-width:470px; color:var(--muted); line-height:1.7; margin:0; }
  .count { color:var(--muted); font-size:13px; white-space:nowrap; }
  .listing-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:24px; }
  .listing-card { display:block; background:#fff; border:1px solid var(--line); text-decoration:none; transition:transform .25s,box-shadow .25s; overflow:hidden; }
  .listing-card:hover { transform:translateY(-4px); box-shadow:0 16px 34px rgba(38,31,21,.1); }
  .listing-image { position:relative; aspect-ratio:1.42; overflow:hidden; background:linear-gradient(145deg,#c8bbaa,#9b8f80); }
  .listing-image img { width:100%; height:100%; object-fit:cover; display:block; transition:transform .4s; }
  .listing-card:hover .listing-image img { transform:scale(1.025); }
  .price { position:absolute; right:14px; bottom:14px; padding:8px 11px; background:rgba(26,26,24,.9); color:#fff; font-size:14px; font-weight:500; }
  .price small { color:#d6d1c9; font-size:10px; font-weight:300; }
  .status { position:absolute; left:14px; top:14px; padding:7px 9px; background:#fff; font-size:9px; font-weight:600; letter-spacing:.1em; text-transform:uppercase; }
  .listing-body { padding:22px; }
  .listing-body h3 { font:500 24px/1.15 'Cormorant Garamond',serif; margin:0 0 10px; }
  .listing-meta { display:flex; align-items:center; flex-wrap:wrap; gap:7px; color:var(--muted); font-size:12px; }
  .listing-meta .dot { width:3px; height:3px; border-radius:50%; background:#aaa297; }
  .amenities { display:flex; flex-wrap:wrap; gap:6px; margin-top:16px; }
  .amenity { background:var(--cream); padding:6px 8px; color:#5f5a51; font-size:10px; }
  .empty { grid-column:1/-1; padding:52px; background:#fff; border:1px solid var(--line); text-align:center; }
  .empty h3 { font:500 30px 'Cormorant Garamond',serif; margin:0 0 10px; }
  .empty p { color:var(--muted); max-width:600px; margin:0 auto 22px; line-height:1.7; }
  .button { display:inline-block; padding:13px 19px; background:var(--ink); color:#fff; text-decoration:none; font-size:12px; font-weight:500; }
  .guide-grid { display:grid; grid-template-columns:.9fr 1.1fr; gap:90px; align-items:start; }
  .guide-copy p { color:#5f5b54; font-size:16px; line-height:1.85; margin:20px 0 0; }
  .planning { display:grid; gap:1px; background:var(--line); border:1px solid var(--line); }
  .planning-item { background:var(--paper); padding:27px 28px; }
  .planning-number { color:var(--gold-dark); font-size:10px; letter-spacing:.16em; }
  .planning-item h3 { font:500 25px 'Cormorant Garamond',serif; margin:8px 0 8px; }
  .planning-item p { color:var(--muted); line-height:1.7; margin:0; font-size:13px; }
  .areas-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:1px; background:var(--line); border:1px solid var(--line); margin-top:38px; }
  .area { background:#fff; padding:30px; }
  .area h3 { font:500 27px 'Cormorant Garamond',serif; margin:0 0 12px; }
  .area p { color:var(--muted); line-height:1.75; margin:0; font-size:14px; }
  .included-grid { display:grid; grid-template-columns:repeat(4,1fr); border:1px solid var(--line); }
  .included { padding:28px; border-right:1px solid var(--line); }
  .included:last-child { border-right:0; }
  .included strong { display:block; font:500 23px 'Cormorant Garamond',serif; margin-bottom:8px; }
  .included span { color:var(--muted); font-size:12px; line-height:1.6; }
  .faq-grid { display:grid; grid-template-columns:.72fr 1.28fr; gap:80px; }
  .faq-note { color:var(--muted); line-height:1.75; margin:18px 0 26px; }
  details { border-top:1px solid var(--line); }
  details:last-child { border-bottom:1px solid var(--line); }
  summary { cursor:pointer; list-style:none; padding:21px 36px 21px 0; font-size:15px; font-weight:500; position:relative; }
  summary::-webkit-details-marker { display:none; }
  summary::after { content:'+'; position:absolute; right:4px; top:18px; color:var(--gold-dark); font-size:22px; font-weight:300; }
  details[open] summary::after { content:'–'; }
  details p { color:var(--muted); line-height:1.75; margin:0; padding:0 38px 22px 0; font-size:14px; }
  .markets { display:flex; gap:10px; flex-wrap:wrap; margin-top:28px; }
  .market-link { padding:10px 13px; border:1px solid var(--line); text-decoration:none; font-size:11px; background:#fff; }
  .market-link[aria-current="page"] { background:var(--ink); color:#fff; border-color:var(--ink); }
  .cta { background:var(--gold); padding:62px 0; }
  .cta-inner { display:flex; justify-content:space-between; align-items:center; gap:35px; }
  .cta h2 { max-width:650px; }
  .cta p { margin:12px 0 0; max-width:650px; line-height:1.7; }
  .cta .button { padding:15px 22px; white-space:nowrap; }
  .footer { background:var(--ink); color:#fff; padding:62px 0 30px; }
  .footer-grid { display:grid; grid-template-columns:2fr 1fr 1fr; gap:70px; }
  .footer-brand p { color:#aaa69f; max-width:390px; font-size:13px; line-height:1.7; margin:18px 0 0; }
  .footer h4 { margin:0 0 17px; color:#d0cbc3; text-transform:uppercase; letter-spacing:.14em; font-size:10px; }
  .footer-col a { display:block; text-decoration:none; color:#aaa69f; font-size:12px; margin:10px 0; }
  .footer-col a:hover { color:#fff; }
  .footer-bottom { display:flex; justify-content:space-between; gap:20px; margin-top:50px; padding-top:22px; border-top:1px solid #343430; color:#88847e; font-size:11px; }
  .footer-bottom a { color:#aaa69f; }
  @media (max-width:900px) {
    .nav-links a:not(.nav-apply) { display:none; }
    .search-bar { grid-template-columns:1fr 1fr; }
    .field:nth-child(2) { border-right:0; }
    .field:nth-child(3) { border-top:1px solid var(--line); }
    .search-button { min-height:70px; border-top:1px solid var(--line); }
    .listing-grid,.areas-grid { grid-template-columns:repeat(2,1fr); }
    .guide-grid,.faq-grid { grid-template-columns:1fr; gap:45px; }
    .included-grid { grid-template-columns:repeat(2,1fr); }
    .included:nth-child(2) { border-right:0; }
    .included:nth-child(-n+2) { border-bottom:1px solid var(--line); }
  }
  @media (max-width:620px) {
    .container { width:min(100% - 32px,1200px); }
    .nav-inner { min-height:72px; }
    .nav-cta { display:none; }
    .hero { padding:62px 0 78px; }
    .search-wrap { margin-top:-22px; }
    .search-bar,.listing-grid,.areas-grid,.included-grid { grid-template-columns:1fr; }
    .field { border-right:0; border-bottom:1px solid var(--line); }
    .field:nth-child(3) { border-top:0; }
    .search-button { min-height:58px; border-top:0; }
    .section { padding:70px 0; }
    .section-head,.cta-inner { align-items:start; flex-direction:column; }
    .included { border-right:0!important; border-bottom:1px solid var(--line); }
    .included:last-child { border-bottom:0; }
    .footer-grid { grid-template-columns:1fr 1fr; gap:40px; }
    .footer-brand { grid-column:1/-1; }
  }
</style>
</head>
<body>
<nav class="nav" aria-label="Primary navigation">
  <div class="container nav-inner">
    <a href="/" class="brand" aria-label="Hive home">
      <svg viewBox="0 0 80 100" aria-hidden="true"><circle cx="40" cy="8" r="4.5" fill="#d4920b"/><rect x="28" y="18" width="24" height="6" rx="3" fill="#d4920b"/><rect x="18" y="32" width="44" height="6" rx="3" fill="#d4920b"/><rect x="15" y="46" width="50" height="6" rx="3" fill="#d4920b"/><rect x="18" y="60" width="44" height="6" rx="3" fill="#d4920b"/><rect x="28" y="74" width="24" height="6" rx="3" fill="#d4920b"/><circle cx="40" cy="88" r="4" fill="#d4920b"/></svg>
      <span><span class="brand-name">Hive</span><span class="brand-tag">City Living, Made Simple</span></span>
    </a>
    <div class="nav-links"><a href="/properties">All Properties</a><a href="/partners">For Landlords</a><a class="nav-cta" href="/contact">Contact</a><a class="nav-cta nav-apply" href="/apply-now">Apply Now</a></div>
  </div>
</nav>

<main>
  <header class="hero">
    <div class="container hero-inner">
      <div class="eyebrow"><%= market.eyebrow %></div>
      <h1><%= market.heading %></h1>
      <p class="hero-lede"><%= market.lede %></p>
      <div class="hero-points"><span>30-day minimum</span><span>Move-in ready</span><span>WiFi and utilities included</span><span>No broker fee</span></div>
    </div>
  </header>

  <div class="container search-wrap">
    <form class="search-bar" action="/short-term-rentals/<%= market.slug %>" method="GET" aria-label="Search <%= market.name %> furnished rentals">
      <div class="field">
        <label for="market-bedrooms">Bedrooms</label>
        <select id="market-bedrooms" name="bedrooms">
          <option value="">Any size</option>
          <option value="0" <%= filters.bedrooms === '0' ? 'selected' : '' %>>Studio</option>
          <option value="1" <%= filters.bedrooms === '1' ? 'selected' : '' %>>1 bedroom</option>
          <option value="2" <%= filters.bedrooms === '2' ? 'selected' : '' %>>2 bedrooms</option>
          <option value="3" <%= filters.bedrooms === '3' ? 'selected' : '' %>>3+ bedrooms</option>
        </select>
      </div>
      <div class="field">
        <label for="market-price">Monthly budget</label>
        <select id="market-price" name="price">
          <option value="">Any budget</option>
          <option value="0-3000" <%= filters.price === '0-3000' ? 'selected' : '' %>>Under $3,000</option>
          <option value="3000-4500" <%= filters.price === '3000-4500' ? 'selected' : '' %>>$3,000–$4,500</option>
          <option value="4500-6000" <%= filters.price === '4500-6000' ? 'selected' : '' %>>$4,500–$6,000</option>
          <option value="6000-999999" <%= filters.price === '6000-999999' ? 'selected' : '' %>>$6,000+</option>
        </select>
      </div>
      <div class="field">
        <label for="market-movein">Stay dates</label>
        <div class="date-inputs"><input id="market-movein" name="movein" type="date" value="<%= filters.movein %>" aria-label="Move-in date"><input id="market-moveout" name="moveout" type="date" value="<%= filters.moveout %>" aria-label="Move-out date"></div>
      </div>
      <button class="search-button" type="submit">Search homes</button>
    </form>
  </div>

  <section class="section" aria-labelledby="available-heading">
    <div class="container">
      <div class="section-head">
        <div><div class="section-label">Current homes</div><h2 id="available-heading">Furnished apartments in <%= market.name %></h2></div>
        <div class="count"><%= listings.length %> <%= listings.length === 1 ? 'home' : 'homes' %> matching</div>
      </div>
      <div class="listing-grid">
        <% listings.forEach(function(listing, index) { var publicName = publicTitle(listing); %>
        <a class="listing-card" href="/properties/<%= listing.id %><%= filters.movein || filters.moveout ? '?' + [filters.movein ? 'movein=' + encodeURIComponent(filters.movein) : '', filters.moveout ? 'moveout=' + encodeURIComponent(filters.moveout) : ''].filter(Boolean).join('&') : '' %>">
          <div class="listing-image">
            <% if (listing.images && listing.images[0]) { %><img src="<%= listing.images[0] %>" alt="<%= publicName %>" <%- index === 0 ? 'fetchpriority="high"' : 'loading="lazy"' %>><% } %>
            <% if (listing.status && listing.status !== 'available') { %><span class="status"><%= listing.status === 'just_listed' ? 'Just listed' : 'Coming soon' %></span><% } %>
            <span class="price">$<%= Number(listing.price_monthly || 0).toLocaleString('en-US') %> <small>/ month</small></span>
          </div>
          <div class="listing-body">
            <h3><%= publicName %></h3>
            <div class="listing-meta"><span><%= listing.neighborhood || market.name %>, <%= listing.city || market.name %></span><span class="dot"></span><span><%= Number(listing.bedrooms) === 0 ? 'Studio' : listing.bedrooms + (Number(listing.bedrooms) === 1 ? ' bedroom' : ' bedrooms') %></span><% if (listing.bathrooms) { %><span class="dot"></span><span><%= listing.bathrooms %> bath</span><% } %></div>
            <% if (listing.key_amenities && listing.key_amenities.length) { %><div class="amenities"><% listing.key_amenities.slice(0,3).forEach(function(amenity) { %><span class="amenity"><%= amenity %></span><% }); %></div><% } %>
          </div>
        </a>
        <% }); %>
        <% if (!listings.length) { %>
        <div class="empty"><h3><%= loadError ? 'Availability is temporarily unavailable.' : 'No homes match these dates yet.' %></h3><p><%= loadError ? 'Please try again shortly or contact Hive for current options.' : 'Inventory changes regularly. Share your dates, budget, and preferred apartment size and the Hive team can discuss upcoming availability in ' + market.name + '.' %></p><a class="button" href="/contact">Ask about <%= market.name %></a></div>
        <% } %>
      </div>
    </div>
  </section>

  <section class="section section-soft">
    <div class="container guide-grid">
      <div class="guide-copy"><div class="section-label">Renting guide</div><h2><%= market.guideTitle %></h2><% market.guideParagraphs.forEach(function(paragraph) { %><p><%= paragraph %></p><% }); %></div>
      <div class="planning"><% market.planning.forEach(function(item,index) { %><article class="planning-item"><div class="planning-number">0<%= index + 1 %></div><h3><%= item.title %></h3><p><%= item.body %></p></article><% }); %></div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head"><div><div class="section-label">Neighborhood fit</div><h2><%= market.areasTitle %></h2></div><p class="section-intro"><%= market.areasIntro %></p></div>
      <div class="areas-grid"><% market.areas.forEach(function(area) { %><article class="area"><h3><%= area.title %></h3><p><%= area.body %></p></article><% }); %></div>
    </div>
  </section>

  <section class="section section-soft">
    <div class="container">
      <div class="section-head"><div><div class="section-label">One monthly home</div><h2>What your furnished stay includes</h2></div><p class="section-intro">The exact furniture and amenities vary by apartment. Every listing provides the details you need before applying.</p></div>
      <div class="included-grid"><div class="included"><strong>Furniture</strong><span>A move-in ready living and sleeping setup.</span></div><div class="included"><strong>WiFi</strong><span>Internet service ready for everyday use.</span></div><div class="included"><strong>Utilities</strong><span>Standard utilities included in monthly pricing.</span></div><div class="included"><strong>Flexible terms</strong><span>A 30-day minimum without a traditional annual lease.</span></div></div>
    </div>
  </section>

  <section class="section">
    <div class="container faq-grid">
      <div><div class="section-label"><%= market.name %> rental questions</div><h2>Frequently asked questions</h2><p class="faq-note">Need an answer about a particular home or date range? The Hive team can confirm listing-specific details.</p><a class="button" href="/contact">Contact Hive</a><div class="markets" aria-label="Explore other markets"><% markets.forEach(function(item) { %><a class="market-link" href="/short-term-rentals/<%= item.slug %>" <% if (item.slug === market.slug) { %>aria-current="page"<% } %>><%= item.name %></a><% }); %></div></div>
      <div><% market.faqs.forEach(function(faq,index) { %><details <%= index === 0 ? 'open' : '' %>><summary><%= faq.question %></summary><p><%= faq.answer %></p></details><% }); %></div>
    </div>
  </section>

  <section class="cta"><div class="container cta-inner"><div><h2>Tell us what you need in <%= market.name %>.</h2><p>Share your dates, preferred apartment size, and budget. We’ll help you understand the next step for current or upcoming furnished rental availability.</p></div><a class="button" href="/apply?property=<%= encodeURIComponent(market.name + ' furnished rental') %>">Start an inquiry</a></div></section>
</main>

<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand"><a href="/" class="brand"><span class="brand-name">Hive</span></a><p>Move-in ready, fully furnished apartments with flexible lease terms for stays of 30 days or longer.</p></div>
      <div class="footer-col"><h4>Residences</h4><% (locals.footerCities || []).forEach(function(city) { %><a href="<%= marketUrl(city) %>"><%= city %></a><% }); %><a href="/properties">All properties</a></div>
      <div class="footer-col"><h4>Support</h4><a href="/contact">Contact</a><a href="/faq">FAQ</a><a href="/partners">For landlords</a><a href="/terms">Terms</a><a href="/privacy">Privacy</a></div>
    </div>
    <div class="footer-bottom"><span>&copy; 2026 Hive. All rights reserved.</span><a href="mailto:hello@hiveny.com">hello@hiveny.com</a></div>
  </div>
</footer>

<script>
(function(){
  var moveIn=document.getElementById('market-movein');
  var moveOut=document.getElementById('market-moveout');
  if(!moveIn||!moveOut)return;
  var today=new Date().toISOString().slice(0,10);
  function addDays(value,days){var date=new Date(value+'T00:00:00');date.setDate(date.getDate()+days);return date.getFullYear()+'-'+String(date.getMonth()+1).padStart(2,'0')+'-'+String(date.getDate()).padStart(2,'0');}
  function updateMinimum(){moveOut.min=moveIn.value?addDays(moveIn.value,30):today;if(moveOut.value&&moveOut.value<moveOut.min)moveOut.value=moveOut.min;}
  moveIn.min=today;moveOut.min=today;moveIn.addEventListener('change',updateMinimum);updateMinimum();
})();
</script>
</body>
</html>
