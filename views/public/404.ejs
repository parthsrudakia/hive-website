<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<%- include('../partials/seo-head') %>
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
  :root { --ink:#1a1a18; --muted:#6d6b65; --cream:#f7f3ec; --gold:#d4920b; }
  * { box-sizing:border-box; }
  body { margin:0; min-height:100vh; display:grid; grid-template-rows:auto 1fr auto; color:var(--ink); background:#fefdfb; font-family:'DM Sans',sans-serif; }
  nav,footer { width:min(1120px,calc(100% - 40px)); margin:auto; }
  nav { min-height:80px; display:flex; align-items:center; justify-content:space-between; }
  .brand { font:600 30px/1 'Cormorant Garamond',serif; text-decoration:none; }
  nav>a:last-child { font-size:14px; text-decoration:none; }
  main { display:grid; place-items:center; text-align:center; padding:64px 20px 90px; background:radial-gradient(circle at 50% 44%,#fff 0,var(--cream) 72%); }
  .code { color:var(--gold); font-size:12px; font-weight:600; letter-spacing:.22em; text-transform:uppercase; }
  h1 { font:500 clamp(54px,9vw,92px)/.95 'Cormorant Garamond',serif; margin:18px 0; }
  p { color:var(--muted); max-width:520px; line-height:1.7; margin:0 auto 30px; }
  .actions { display:flex; justify-content:center; gap:12px; flex-wrap:wrap; }
  .button { padding:13px 20px; background:var(--ink); color:#fff; text-decoration:none; font-size:14px; }
  .button.secondary { background:transparent; color:var(--ink); border:1px solid #cfc7bb; }
  footer { border-top:1px solid #e6dfd4; min-height:74px; display:flex; align-items:center; justify-content:space-between; gap:20px; color:var(--muted); font-size:13px; }
</style>
</head>
<body>
<nav><a class="brand" href="/">Hive</a><a href="/contact">Need help?</a></nav>
<main>
  <div>
    <div class="code">Error 404</div>
    <h1>This page moved out.</h1>
    <p>We couldn’t find the page you were looking for. Explore current furnished apartments or head back to the Hive homepage.</p>
    <div class="actions"><a class="button" href="/properties">Browse properties</a><a class="button secondary" href="/">Back home</a></div>
  </div>
</main>
<footer><span>&copy; 2026 Hive</span><a href="mailto:hello@hiveny.com">hello@hiveny.com</a></footer>
</body>
</html>
